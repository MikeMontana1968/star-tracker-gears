# Generated meshes — large and fully reproducible from the .scad.
# Regenerate with:  .\build.ps1
out/*.stl
out/**/*.stl

# Disposable verification and superseded exports.
out/_scratch/

# Small human-facing artifacts under out/docs/ ARE tracked on purpose:
# the assembly renders, the laser SVG and the 1:1 drilling template are
# deliverables you want visible without running a build.

# Noise
__pycache__/
*.pyc
Thumbs.db
desktop.ini
*~

# Controller PCB — generated outputs. The KiCad project itself IS tracked
# (it is what you open and what you send to a fab), but these are rebuilt by
#   python hardware\gen_board.py   +   fill_zones.py
hardware/gerbers/
hardware/nl.net
hardware/*.rpt
hardware/star_tracker_ctrl/*.kicad_prl
hardware/star_tracker_ctrl/*-backups/
